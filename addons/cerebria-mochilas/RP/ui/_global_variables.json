{
	// APAGADO A PROPOSITO (desviacion del upstream). En la fila de inventario de
	// Chest-UI lo que se DIBUJA y lo que se PULSA no coinciden: se midio en el
	// juego que muestra los objetos correctos y devuelve indices de la rejilla
	// (sel=1 al tocar la barra rapida), y con la mochila vacia esos botones son
	// invisibles, asi que el toque cae al fondo y sale UserClosed.
	// El inventario del jugador se dibuja ahora DENTRO de la rejilla, que si
	// responde bien. Ver abrirMochila() en src/mochilas.js.
	"$show_inventory": false,
	"$border_and_background_texture": "textures/ui/dialog_background_opaque", // Add your own texture for background and border here. Edit `textures/ui/item_background` to change slot texture.
	/*
		*It is important to only enable the layouts that you're going to use and disable others to decrease lag*
	*/
	// OJO: activar aqui el layout de CADA tamano que use el codigo. Si abres un
	// cofre de un tamano desactivado no falla ni avisa: sale una pantalla
	// transparente sin boton de cerrar. Las mochilas usan 9, 18 y 27.
	//
	// Se activan TODOS los tamanos. Upstream los trae casi todos apagados solo
	// por rendimiento, no porque estorben, y tenerlos apagados ya costo una
	// ronda entera de diagnostico con la pantalla transparente. El coste es
	// dibujar unos paneles de mas; el beneficio es que ningun tamano vuelva a
	// fallar en silencio.
	"$disable_furnace_ui": true,
	"$disable_1_slots_layout": false,
	"$disable_5_slots_layout": false,
	"$disable_9_slots_layout": false,
	"$disable_18_slots_layout": false,
	"$disable_27_slots_layout": false,
	"$disable_36_slots_layout": false,
	"$disable_45_slots_layout": false,
	"$disable_54_slots_layout": false
}
